---
interface Props {
  name: string;
  role: string;
  specialty: string;
  bio: string;
  image: string;
}

const { name, role, specialty, bio, image } = Astro.props;

const teamImages: Record<string, string> = {
  'Isabelle Laurent': 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=1920&q=85&fit=crop&crop=faces&auto=format',
  'Marcus Chen': 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1920&q=85&fit=crop&crop=faces&auto=format',
  'Dr. Priya Sharma': 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=1920&q=85&fit=crop&crop=faces&auto=format',
  'Elena Voss': 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=1920&q=85&fit=crop&crop=faces&auto=format',
  'Amara Osei': 'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=1920&q=85&fit=crop&crop=faces&auto=format',
  'James Whitfield': 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=1920&q=85&fit=crop&crop=faces&auto=format',
};

const imgSrc = teamImages[name] || 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=1920&q=85&fit=crop&crop=faces&auto=format';
---

<div data-stagger-child>
  <div class="img-zoom" style="margin-bottom: 24px;">
    <img
      src={imgSrc}
      alt={`Portrait of ${name}`}
      loading="lazy"
      decoding="async"
      style="width: 100%; aspect-ratio: 3/4; object-fit: cover;"
    />
  </div>

  <h3 class="font-heading" style="font-size: 1.5rem; font-weight: 300; font-style: italic; margin: 0 0 6px;">
    {name}
  </h3>
  <span class="eyebrow text-sage" style="display: block; margin-bottom: 6px; font-size: 0.62rem;">
    {role}
  </span>
  <span class="font-accent text-gold" style="font-size: 0.92rem; font-style: italic; display: block; margin-bottom: 14px;">
    {specialty}
  </span>
  <p class="text-muted" style="font-size: 0.88rem; line-height: 1.75;">
    {bio}
  </p>
</div>
