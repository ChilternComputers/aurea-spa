---
interface Props {
  name: string;
  role: string;
  specialty: string;
  bio: string;
  image: string;
}

const { name, role, specialty, bio, image } = Astro.props;
---

<div data-stagger-child>
  <div class="img-zoom" style="margin-bottom: 24px;">
    <img
      src={image}
      srcset={`${image.replace('w=800', 'w=400')} 400w, ${image} 800w`}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      width={600}
      height={800}
      alt={`Portrait of ${name}`}
      loading="lazy"
      decoding="async"
      style="width: 100%; aspect-ratio: 3/4; object-fit: cover;"
    />
  </div>

  <h3 class="font-heading" style="font-size: 1.5rem; font-weight: 300; font-style: italic; margin: 0 0 6px;">
    {name}
  </h3>
  <span class="eyebrow text-sage" style="display: block; margin-bottom: 6px; font-size: 0.62rem;">
    {role}
  </span>
  <span class="font-accent text-gold" style="font-size: 0.92rem; font-style: italic; display: block; margin-bottom: 14px;">
    {specialty}
  </span>
  <p class="text-muted" style="font-size: 0.88rem; line-height: 1.75;">
    {bio}
  </p>
</div>
