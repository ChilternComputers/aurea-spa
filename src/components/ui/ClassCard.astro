---
interface Props {
  name: string;
  description: string;
  instructor: string;
  duration: string;
  price: number;
  image: string;
  imageAlt: string;
}

const { name, description, instructor, duration, price, image, imageAlt } = Astro.props;
---

<div
  class="bg-white class-card"
  style="border: 1px solid var(--color-border); display: flex; flex-direction: column; height: 100%; transition: border-color 0.3s ease; overflow: hidden;"
  data-stagger-child
>
  <div class="img-zoom" style="aspect-ratio: 16/10; overflow: hidden;">
    <img
      src={image.replace('w=800', 'w=500')}
      srcset={`${image.replace('w=800', 'w=400')} 400w, ${image.replace('w=800', 'w=500')} 500w`}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
      alt={imageAlt}
      width={500}
      height={312}
      loading="lazy"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
  </div>

  <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
      <h3 class="font-heading" style="font-size: 1.25rem; font-weight: 400; font-style: italic; margin: 0; flex: 1;">
        {name}
      </h3>
      <span class="text-sage font-body" style="font-size: 1rem; font-weight: 600; white-space: nowrap; margin-left: 16px;">
        &pound;{price}
      </span>
    </div>

    <p style="font-size: 0.78rem; color: var(--color-gold); margin-bottom: 12px;">
      with {instructor}
    </p>

    <p class="text-muted" style="font-size: 0.85rem; line-height: 1.75; flex: 1; margin-bottom: 16px;">
      {description}
    </p>

    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 14px;">
      <span class="text-muted" style="font-size: 0.78rem; display: flex; align-items: center; gap: 6px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {duration}
      </span>
      <a
        href="/booking/"
        class="nav-link font-body text-sage"
        style="font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600;"
        aria-label={`Book ${name}`}
      >
        Book &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .class-card:hover,
  .class-card:focus-within {
    border-color: var(--color-gold) !important;
  }
</style>
