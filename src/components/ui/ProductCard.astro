---
interface Props {
  name: string;
  brand: string;
  description: string;
  price: number;
  image: string;
  imageAlt: string;
}

const { name, brand, description, price, image, imageAlt } = Astro.props;
---

<div
  class="bg-white product-card"
  style="border: 1px solid var(--color-border); display: flex; flex-direction: column; height: 100%; transition: border-color 0.3s ease; overflow: hidden;"
  data-stagger-child
>
  <div class="img-zoom" style="aspect-ratio: 1/1; overflow: hidden;">
    <img
      src={image.replace('w=800', 'w=300').replace('q=85', 'q=75')}
      srcset={`${image.replace('w=800', 'w=200').replace('q=85', 'q=75')} 200w, ${image.replace('w=800', 'w=300').replace('q=85', 'q=75')} 300w`}
      sizes="(max-width: 768px) 45vw, (max-width: 1024px) 30vw, 22vw"
      alt={imageAlt}
      width={300}
      height={300}
      loading="lazy"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
  </div>

  <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
    <span class="eyebrow" style="font-size: 0.55rem; margin-bottom: 6px; display: block;">{brand}</span>

    <h3 class="font-heading" style="font-size: 1.15rem; font-weight: 400; font-style: italic; margin: 0 0 6px; line-height: 1.3;">
      {name}
    </h3>

    <span class="text-sage font-body" style="font-size: 1.05rem; font-weight: 600; display: block; margin-bottom: 10px;">
      &pound;{price}
    </span>

    <p class="text-muted" style="font-size: 0.82rem; line-height: 1.7; flex: 1; margin-bottom: 16px;">
      {description}
    </p>

    <a
      href="/contact/"
      class="btn-primary btn-outline btn-sm"
      style="text-align: center; padding: 10px 20px;"
      aria-label={`Enquire about ${name}`}
    >
      Enquire
    </a>
  </div>
</div>

<style>
  .product-card:hover,
  .product-card:focus-within {
    border-color: var(--color-gold) !important;
  }
</style>
