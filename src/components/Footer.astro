---
import { SITE } from '@/config';
---

<footer role="contentinfo" style="background: #1a1a1a;">
  <!-- Main footer -->
  <div style="max-width: 1100px; margin: 0 auto; padding: 64px clamp(24px, 4vw, 48px) 32px;">

    <!-- Brand centered -->
    <div style="text-align: center; margin-bottom: 48px;">
      <span class="font-heading" style="font-size: 1.6rem; letter-spacing: 0.3em; font-weight: 300; color: var(--color-cream); display: block; margin-bottom: 12px;">
        AUREA
      </span>
      <p class="font-accent" style="font-size: 1rem; font-style: italic; color: rgba(245,240,235,0.55);">
        A sanctuary of beauty &amp; wellbeing
      </p>
    </div>

    <!-- Compact info row -->
    <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 12px 40px; margin-bottom: 40px; text-align: center;">
      <span style="font-size: 0.82rem; color: rgba(245,240,235,0.5);">
        {SITE.address.street}, {SITE.address.area}, {SITE.address.city} {SITE.address.postcode}
      </span>
      <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 0.82rem; color: rgba(245,240,235,0.5); transition: color 0.3s ease;" class="hover:text-cream">
        {SITE.phone}
      </a>
      <a href={`mailto:${SITE.email}`} style="font-size: 0.82rem; color: rgba(245,240,235,0.5); transition: color 0.3s ease;" class="hover:text-cream">
        {SITE.email}
      </a>
    </div>

    <!-- Nav links inline -->
    <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 32px; margin-bottom: 40px;">
      <a href="/treatments/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Treatments</a>
      <a href="/about/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">About</a>
      <a href="/team/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Team</a>
      <a href="/gallery/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Gallery</a>
      <a href="/pricing/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Pricing</a>
      <a href="/gift-vouchers/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Gift Vouchers</a>
      <a href="/booking/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Booking</a>
      <a href="/contact/" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245,240,235,0.55); transition: color 0.3s ease;" class="hover:text-cream">Contact</a>
    </div>

    <!-- Social -->
    <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 40px;">
      <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="color: rgba(245,240,235,0.35); transition: color 0.3s ease; padding: 12px; display: inline-flex; align-items: center; justify-content: center;" class="hover:text-cream">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color: rgba(245,240,235,0.35); transition: color 0.3s ease; padding: 12px; display: inline-flex; align-items: center; justify-content: center;" class="hover:text-cream">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="color: rgba(245,240,235,0.35); transition: color 0.3s ease; padding: 12px; display: inline-flex; align-items: center; justify-content: center;" class="hover:text-cream">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
      </a>
    </div>

    <!-- Divider + bottom -->
    <div style="border-top: 1px solid rgba(245,240,235,0.06); padding-top: 24px; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px;">
      <span style="font-size: 0.7rem; color: rgba(245,240,235,0.45);">
        &copy; {new Date().getFullYear()} AUREA. All rights reserved.
      </span>
      <a href="/privacy/" style="font-size: 0.7rem; color: rgba(245,240,235,0.45); transition: color 0.3s ease;" class="hover:text-cream">
        Privacy Policy
      </a>
      <a href="/terms/" style="font-size: 0.7rem; color: rgba(245,240,235,0.45); transition: color 0.3s ease;" class="hover:text-cream">
        Terms &amp; Conditions
      </a>
      <a href="/accessibility/" style="font-size: 0.7rem; color: rgba(245,240,235,0.45); transition: color 0.3s ease;" class="hover:text-cream">
        Accessibility
      </a>
    </div>
  </div>
</footer>
