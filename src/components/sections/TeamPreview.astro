---
import { featuredTeam } from '@/data/team';
---

<section class="section-padding-md" aria-label="Our team">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">

    <div style="text-align: center; margin-bottom: clamp(48px, 6vw, 80px);" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 16px;">Our Team</span>
      <h2 style="margin: 0;">Meet Your Artists</h2>
      <div class="line-accent" style="margin: 24px auto 0;"></div>
    </div>

    <div
      style="display: grid; grid-template-columns: 1fr; gap: clamp(32px, 4vw, 48px);"
      class="md:grid-cols-3"
      data-stagger-parent
    >
      {featuredTeam.map((m) => (
        <div data-stagger-child>
          <div class="img-zoom" style="margin-bottom: 24px;">
            <img
              src={m.image}
              srcset={`${m.image.replace('w=800', 'w=400')} 400w, ${m.image} 800w`}
              sizes="(max-width: 640px) 100vw, 33vw"
              width={600}
              height={800}
              alt={`Portrait of ${m.name}`}
              loading="lazy"
              decoding="async"
              style="width: 100%; aspect-ratio: 3/4; object-fit: cover;"
            />
          </div>
          <h3 class="font-heading" style="font-size: 1.5rem; font-weight: 300; font-style: italic; margin: 0 0 4px;">
            {m.name}
          </h3>
          <span class="eyebrow text-sage" style="display: block; margin-bottom: 6px; font-size: 0.62rem;">
            {m.role}
          </span>
          <span class="font-accent text-gold" style="font-size: 0.95rem; font-style: italic;">
            {m.specialty}
          </span>
        </div>
      ))}
    </div>

    <div style="text-align: center; margin-top: clamp(40px, 5vw, 64px);" data-reveal>
      <a
        href="/team/"
        class="btn-primary btn-outline"
        aria-label="Meet the full AUREA team"
      >
        Meet the Full Team
      </a>
    </div>
  </div>
</section>
