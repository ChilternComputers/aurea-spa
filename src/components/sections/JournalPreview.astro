---
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/ui/ArticleCard.astro';

const allPosts = await getCollection('journal');
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section style="padding: clamp(80px, 12vw, 160px) 0; background: #FAFAF8;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: clamp(40px, 5vw, 64px);" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 16px;">From the Journal</span>
      <h2 style="margin: 0 0 20px;">Wellness &amp; Beauty</h2>
      <p class="text-muted" style="font-size: 0.95rem; max-width: 520px; margin: 0 auto; line-height: 1.8;">
        Expert advice, seasonal guides and behind-the-scenes insights from the AUREA team.
      </p>
    </div>

    <div
      style="display: grid; grid-template-columns: 1fr; gap: 32px;"
      class="md:grid-cols-2 lg:grid-cols-3"
      data-stagger-parent
    >
      {latestPosts.map((post) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          author={post.data.author}
          date={post.data.date}
          category={post.data.category}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          readTime={post.data.readTime}
          slug={post.id.replace(/\.md$/, '')}
        />
      ))}
    </div>

    <div style="text-align: center; margin-top: 48px;" data-reveal>
      <a href="/journal/" class="btn-primary btn-outline">
        View All Articles
      </a>
    </div>
  </div>
</section>
