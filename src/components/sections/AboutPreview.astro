---
import { IMAGES, unsplash } from '@/data/images';
---

<!-- About: Cinematic video section with minimal text -->
<section class="section-padding-lg" style="position: relative; overflow: hidden;" aria-label="About AUREA">
  <!-- Video background — essential oil being poured -->
  <div style="position: absolute; inset: 0; z-index: 0; aspect-ratio: 16/9;">
    <video
      id="about-video"
      muted loop playsinline preload="none"
      poster={unsplash(IMAGES.aboutOil, 1344, 45)}
      style="width: 100%; height: 100%; object-fit: cover;"
      aria-hidden="true"
    >
    </video>
    <img
      src={unsplash(IMAGES.aboutOil, 1920)}
      srcset={`${unsplash(IMAGES.aboutOil, 800)} 800w, ${unsplash(IMAGES.aboutOil, 1200)} 1200w, ${unsplash(IMAGES.aboutOil, 1920)} 1920w`}
      sizes="100vw"
      alt=""
      role="presentation"
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none;"
      data-video-fallback
    />
    <div style="position: absolute; inset: 0; background: var(--overlay-dark);"></div>
  </div>

  <!-- Content -->
  <div style="position: relative; z-index: 1; max-width: 700px; margin: 0 auto; text-align: center; padding: 0 24px;" data-reveal>
    <span
      class="eyebrow"
      style="display: block; margin-bottom: 20px; color: rgba(197, 165, 114, 0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3);"
    >
      Our Philosophy
    </span>

    <h2 style="margin: 0 0 28px; color: #FFFFFF; text-shadow: 0 2px 16px rgba(0,0,0,0.4);">
      Beauty as a<br>Form of Care
    </h2>

    <p style="font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.9; color: rgba(255,255,255,0.85); margin-bottom: 48px; text-shadow: 0 1px 6px rgba(0,0,0,0.3); font-weight: 300;">
      Expert artistry meets genuine restoration. A space designed to slow you down — where every detail, every moment, is considered.
    </p>

    <a
      href="/about/"
      class="btn-primary"
      style="background: transparent; border: 1px solid rgba(255,255,255,0.4); color: #FFFFFF;"
      aria-label="Read our story — about AUREA"
    >
      Our Story
    </a>
  </div>
</section>

<script>
  import { initLazyVideo } from '@/lib/video';
  initLazyVideo('about-video', '/videos/about.webm', '/videos/about.mp4');
</script>
