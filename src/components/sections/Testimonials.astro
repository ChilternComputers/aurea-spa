---
import { testimonials } from '@/data/testimonials';
---

<section style="position: relative; padding: clamp(80px, 12vw, 160px) 0; overflow: hidden;" aria-label="Client testimonials">
  <!-- Ambient video background — rain on water -->
  <div style="position: absolute; inset: 0; z-index: 0;">
    <video
      autoplay muted loop playsinline preload="metadata"
      poster="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1920&q=60&fit=crop&auto=format"
      style="width: 100%; height: 100%; object-fit: cover;"
      aria-hidden="true"
    >
      <source src="https://assets.mixkit.co/videos/45571/45571-720.mp4" type="video/mp4" />
    </video>
    <div style="position: absolute; inset: 0; background: rgba(10,10,10,0.8);"></div>
  </div>

  <div style="position: relative; z-index: 1; max-width: 900px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">

    <div style="text-align: center; margin-bottom: clamp(40px, 5vw, 64px);" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 16px; color: rgba(197, 165, 114, 0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3);">Testimonials</span>
      <h2 style="margin: 0; color: #FFFFFF; text-shadow: 0 2px 16px rgba(0,0,0,0.4);">Words from Our Clients</h2>
    </div>

    <!-- Carousel -->
    <div style="position: relative; overflow: hidden;" data-reveal>
      <div id="testimonial-track" aria-live="polite" style="display: flex; transition: transform 0.7s cubic-bezier(0.445, 0.05, 0.55, 0.95);">
        {testimonials.map((t) => (
          <div style="min-width: 100%; padding: 0 16px; text-align: center;">
            <!-- Stars -->
            <div style="display: flex; justify-content: center; gap: 3px; margin-bottom: 32px;" aria-label={`${t.rating} out of 5 stars`}>
              {Array.from({ length: t.rating }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--color-gold)" stroke="none">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              ))}
            </div>

            <blockquote class="font-accent" style="font-size: clamp(1.15rem, 2.5vw, 1.6rem); font-style: italic; line-height: 1.75; margin: 0 0 32px; font-weight: 300; color: rgba(255,255,255,0.9); text-shadow: 0 1px 8px rgba(0,0,0,0.3);">
              &ldquo;{t.quote}&rdquo;
            </blockquote>

            <div>
              <span class="font-body" style="font-size: 0.85rem; font-weight: 500; display: block; margin-bottom: 4px; color: #FFFFFF;">
                {t.author}
              </span>
              <span style="font-size: 0.78rem; color: rgba(197, 165, 114, 0.7);">
                {t.treatment}
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Dots + Pause -->
      <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 48px;">
        {testimonials.map((_, i) => (
          <button
            class="t-dot"
            data-index={i}
            aria-label={`Testimonial ${i + 1}`}
            style={`width: ${i === 0 ? '24px' : '8px'}; height: 2px; border: none; background: ${i === 0 ? 'var(--color-gold)' : 'rgba(245,240,235,0.25)'}; cursor: pointer; padding: 20px 0; background-clip: content-box; transition: all 0.4s ease;`}
          />
        ))}
        <button
          id="testimonial-pause"
          aria-label="Pause testimonial carousel"
          style="background: none; border: 1px solid rgba(245,240,235,0.25); color: rgba(245,240,235,0.7); cursor: pointer; padding: 4px 8px; margin-left: 8px; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; transition: border-color 0.3s ease; min-height: 28px; display: flex; align-items: center; gap: 4px;"
        >
          <span aria-hidden="true">&#10074;&#10074;</span> Pause
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track');
  const dots = document.querySelectorAll('.t-dot');
  const pauseBtn = document.getElementById('testimonial-pause');
  let current = 0;
  const total = dots.length;
  let paused = false;
  let timer: ReturnType<typeof setInterval>;

  function goTo(i: number) {
    current = i;
    if (track) track.style.transform = `translateX(-${i * 100}%)`;
    dots.forEach((d, idx) => {
      const el = d as HTMLElement;
      el.style.width = idx === i ? '24px' : '8px';
      el.style.background = idx === i ? 'var(--color-gold)' : 'rgba(245,240,235,0.25)';
    });
  }

  dots.forEach(d => d.addEventListener('click', () => goTo(parseInt(d.getAttribute('data-index') || '0'))));

  function startTimer() {
    timer = setInterval(() => { if (!paused) goTo((current + 1) % total); }, 6000);
  }
  startTimer();

  if (pauseBtn) {
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.innerHTML = paused
        ? '<span aria-hidden="true">&#9654;</span> Play'
        : '<span aria-hidden="true">&#10074;&#10074;</span> Pause';
      pauseBtn.setAttribute('aria-label', paused ? 'Play testimonial carousel' : 'Pause testimonial carousel');
    });
  }
</script>
