---
import { galleryImages } from '@/data/gallery';

const tallCategories = new Set(['hair', 'nails']);
const galleryPreviewImages = galleryImages.slice(0, 6).map((img) => ({
  src: img.src,
  alt: img.alt,
  tall: tallCategories.has(img.category) && img.height > img.width,
  width: img.width,
  height: img.height,
}));
---

<section class="bg-white section-padding-md" aria-label="Gallery preview">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">

    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: clamp(40px, 5vw, 64px); flex-wrap: wrap; gap: 24px;" data-reveal>
      <div>
        <span class="eyebrow" style="display: block; margin-bottom: 16px;">Gallery</span>
        <h2 style="margin: 0;">Our Work</h2>
      </div>
      <a
        href="/gallery/"
        class="nav-link font-body text-sage"
        style="font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 500; display: inline-flex; align-items: center; gap: 10px;"
        aria-label="View full gallery of our work"
      >
        View Full Gallery
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <!-- Editorial masonry grid -->
    <div
      style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px;"
      class="lg:grid-cols-3"
      data-stagger-parent
    >
      {galleryPreviewImages.map((img) => (
        <div
          class="img-zoom"
          style={`${img.tall ? 'grid-row: span 2;' : ''}`}
          data-stagger-child
        >
          <img
            src={img.src}
            srcset={`${img.src.replace('w=800', 'w=400')} 400w, ${img.src} 800w`}
            sizes="(max-width: 640px) 50vw, 33vw"
            alt={img.alt}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
            style={`width: 100%; height: 100%; object-fit: cover; ${img.tall ? 'min-height: 400px;' : 'aspect-ratio: 4/3;'}`}
          />
        </div>
      ))}
    </div>
  </div>
</section>
