---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { title, subtitle, description, image, imageAlt = '' } = Astro.props;
const bgImage = image || '/images/unsplash/1596178065887-1198b6148b2b.webp';
---

<section style="position: relative; padding: clamp(140px, 18vw, 220px) 0 clamp(80px, 10vw, 120px); overflow: hidden;">
  <!-- Background -->
  <div style="position: absolute; inset: 0; z-index: 0;">
    <img
      src={bgImage}
      srcset={`${bgImage.replace('w=1920', 'w=800')} 800w, ${bgImage.replace('w=1920', 'w=1200')} 1200w, ${bgImage} 1920w`}
      sizes="100vw"
      alt={imageAlt}
      width={1920}
      height={1080}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26,26,26,0.5) 0%, rgba(26,26,26,0.65) 100%);"></div>
  </div>

  <div style="position: relative; z-index: 1; text-align: center; max-width: 750px; margin: 0 auto; padding: 0 24px;">
    {subtitle && (
      <span class="eyebrow" style="display: block; margin-bottom: 20px; color: rgba(197, 165, 114, 0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3);">
        {subtitle}
      </span>
    )}
    <h1 style="margin: 0; color: #FFFFFF; text-shadow: 0 2px 16px rgba(0,0,0,0.4);">
      {title}
    </h1>
    {description && (
      <p style="font-size: 1.05rem; line-height: 1.85; color: rgba(255,255,255,0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3); margin: 28px 0 0; max-width: 520px; display: inline-block;">
        {description}
      </p>
    )}
  </div>
</section>
