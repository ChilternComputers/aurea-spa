---
import { SITE } from '@/config';
import { IMAGES, unsplash } from '@/data/images';
---

<section
  class="section-padding-lg"
  style="position: relative; overflow: hidden;"
  aria-label="Book your appointment"
>
  <!-- Ambient video background — candle flames -->
  <div style="position: absolute; inset: 0; z-index: 0; aspect-ratio: 16/9;">
    <video
      id="cta-video"
      muted loop playsinline preload="none"
      poster={unsplash(IMAGES.heroCandle, 1920, 60)}
      style="width: 100%; height: 100%; object-fit: cover;"
      aria-hidden="true"
    >
    </video>
    <img
      src={unsplash(IMAGES.heroCandle, 1920)}
      srcset={`${unsplash(IMAGES.heroCandle, 800)} 800w, ${unsplash(IMAGES.heroCandle, 1200)} 1200w, ${unsplash(IMAGES.heroCandle, 1920)} 1920w`}
      sizes="100vw"
      alt=""
      role="presentation"
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none;"
      data-video-fallback
    />
    <div style="position: absolute; inset: 0; background: var(--overlay-dark);"></div>
  </div>

  <!-- Content -->
  <div style="position: relative; z-index: 1; max-width: 680px; margin: 0 auto; text-align: center; padding: 0 24px;" data-reveal>
    <span class="eyebrow" style="display: block; margin-bottom: 20px; color: rgba(197, 165, 114, 0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3);">
      Begin Your Journey
    </span>

    <h2 style="margin: 0 0 24px; color: #FFFFFF; text-shadow: 0 2px 16px rgba(0,0,0,0.4);">
      Your Moment of<br>Restoration Awaits
    </h2>

    <p style="font-size: 1rem; line-height: 1.85; color: rgba(255,255,255,0.8); text-shadow: 0 1px 6px rgba(0,0,0,0.3); margin-bottom: 48px; max-width: 480px; display: inline-block;">
      Whether it's a transformative colour, a restorative massage, or a complete day of indulgence — we're here to make it exceptional.
    </p>

    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a
        href="/booking/"
        class="btn-primary btn-fill btn-lg"
      >
        Book Online
      </a>
      <a
        href={`tel:${SITE.phone.replace(/\s/g, '')}`}
        class="btn-primary btn-outline-light btn-lg"
      >
        Call {SITE.phone}
      </a>
    </div>
  </div>
</section>

<script>
  import { initLazyVideo } from '@/lib/video';
  initLazyVideo('cta-video', '/videos/cta.webm', '/videos/cta.mp4');
</script>
