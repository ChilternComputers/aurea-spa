---
import { timetable } from '@/data/classes';

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const slotsByDay = days.map((day) => ({
  day,
  slots: timetable.filter((s) => s.day === day),
}));
---

<section style="padding: clamp(60px, 8vw, 100px) 0; background: #FAFAF8;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: clamp(40px, 5vw, 64px);" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 16px;">Schedule</span>
      <h2 style="margin: 0;">Weekly Timetable</h2>
    </div>

    <!-- Desktop timetable -->
    <div class="timetable-desktop" data-reveal>
      <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border);">
        {days.map((day) => (
          <div class="bg-sage" style="padding: 12px 8px; text-align: center;">
            <span class="font-body" style="font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 500; color: var(--color-cream);">
              {day.slice(0, 3)}
            </span>
          </div>
        ))}
        {slotsByDay.map(({ slots }) => (
          <div class="bg-white" style="padding: 12px 10px; min-height: 120px;">
            {slots.length > 0 ? (
              slots.map((slot) => (
                <div style="margin-bottom: 12px;">
                  <span style="font-size: 0.7rem; font-weight: 600; color: var(--color-sage); display: block;">
                    {slot.time}
                  </span>
                  <span class="font-heading" style="font-size: 0.85rem; font-style: italic; display: block; line-height: 1.3;">
                    {slot.className}
                  </span>
                  <span style="font-size: 0.65rem; color: var(--color-muted);">
                    {slot.duration} · {slot.instructor}
                  </span>
                </div>
              ))
            ) : (
              <span style="font-size: 0.75rem; color: var(--color-border); font-style: italic;">—</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile timetable -->
    <div class="timetable-mobile" data-reveal>
      {slotsByDay.filter(({ slots }) => slots.length > 0).map(({ day, slots }) => (
        <div style="margin-bottom: 24px;">
          <h3 class="font-body" style="font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--color-sage); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--color-border);">
            {day}
          </h3>
          {slots.map((slot) => (
            <div style="display: flex; align-items: baseline; gap: 16px; padding: 8px 0;">
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-sage); min-width: 50px;">
                {slot.time}
              </span>
              <div>
                <span class="font-heading" style="font-size: 1rem; font-style: italic; display: block;">
                  {slot.className}
                </span>
                <span style="font-size: 0.75rem; color: var(--color-muted);">
                  {slot.duration} · {slot.instructor}
                </span>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timetable-desktop { display: none; }
  .timetable-mobile { display: block; }

  @media (min-width: 768px) {
    .timetable-desktop { display: block; }
    .timetable-mobile { display: none; }
  }
</style>
