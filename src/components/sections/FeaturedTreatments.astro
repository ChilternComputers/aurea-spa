---
import { featuredTreatments } from '@/data/treatments';
import { IMAGES, unsplash } from '@/data/images';
const top3 = featuredTreatments.slice(0, 3);
---

<!-- Treatments: Video background with 3 signature treatments -->
<section class="section-padding-lg" style="position: relative; overflow: hidden;" aria-label="Signature treatments">
  <!-- Video background — skincare / hands applying cream -->
  <div style="position: absolute; inset: 0; z-index: 0; aspect-ratio: 16/9;">
    <video
      id="treatments-video"
      muted loop playsinline preload="none"
      poster={unsplash(IMAGES.treatmentsSkincare, 720, 35)}
      style="width: 100%; height: 100%; object-fit: cover;"
      aria-hidden="true"
    >
    </video>
    <img
      src={unsplash(IMAGES.treatmentsSkincare, 1920)}
      srcset={`${unsplash(IMAGES.treatmentsSkincare, 800)} 800w, ${unsplash(IMAGES.treatmentsSkincare, 1200)} 1200w, ${unsplash(IMAGES.treatmentsSkincare, 1920)} 1920w`}
      sizes="100vw"
      alt=""
      role="presentation"
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none;"
      data-video-fallback
    />
    <div style="position: absolute; inset: 0; background: var(--overlay-darker);"></div>
  </div>

  <!-- Content -->
  <div style="position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
    <div style="text-align: center; margin-bottom: clamp(48px, 6vw, 72px);" data-reveal>
      <span
        class="eyebrow"
        style="display: block; margin-bottom: 16px; color: rgba(197, 165, 114, 0.85); text-shadow: 0 1px 6px rgba(0,0,0,0.3);"
      >
        Curated Experiences
      </span>
      <h2 style="margin: 0; color: #FFFFFF; text-shadow: 0 2px 16px rgba(0,0,0,0.4);">
        Signature Treatments
      </h2>
    </div>

    <!-- 3 treatments as glass cards -->
    <div
      style="display: grid; grid-template-columns: 1fr; gap: 24px;"
      class="md:grid-cols-3"
      data-stagger-parent
    >
      {top3.map((t) => (
        <a
          href="/treatments/"
          style="display: block; padding: clamp(32px, 4vw, 48px); background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); text-align: center; transition: all 0.4s ease; text-decoration: none;"
          data-stagger-child
        >
          <span
            class="eyebrow"
            style="display: block; margin-bottom: 16px; font-size: 0.6rem; color: rgba(197, 165, 114, 0.7);"
          >
            {t.category} &middot; {t.duration}
          </span>
          <h3
            class="font-heading"
            style="font-size: clamp(1.4rem, 2.5vw, 1.8rem); font-weight: 300; font-style: italic; margin: 0 0 12px; color: #FFFFFF;"
          >
            {t.name}
          </h3>
          <span
            class="font-body"
            style="font-size: 1.1rem; font-weight: 500; color: var(--color-gold);"
          >
            &pound;{t.price}
          </span>
        </a>
      ))}
    </div>

    <div style="text-align: center; margin-top: clamp(40px, 5vw, 56px);" data-reveal>
      <a
        href="/treatments/"
        class="btn-primary"
        style="background: transparent; border: 1px solid rgba(255,255,255,0.35); color: rgba(255,255,255,0.85);"
        aria-label="View all AUREA treatments"
      >
        View All Treatments
      </a>
    </div>
  </div>
</section>

<style>
  a[data-stagger-child]:hover {
    background: rgba(255,255,255,0.12) !important;
    border-color: rgba(255,255,255,0.25) !important;
  }
</style>

<script>
  import { initLazyVideo } from '@/lib/video';
  initLazyVideo('treatments-video', '/videos/treatments.webm', '/videos/treatments.mp4');
</script>
