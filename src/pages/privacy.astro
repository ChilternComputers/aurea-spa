---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { SITE } from '@/config';
import { getWebPageSchema } from '@/lib/schemas';
---

<Layout
  title="Privacy Policy"
  description="AUREA's privacy policy. How we collect, use, and protect your personal data."
  noindex={true}
  schema={getWebPageSchema({
    title: 'Privacy Policy — AUREA',
    description: 'How AUREA handles your personal data.',
    url: `${SITE.url}/privacy/`,
  })}
>
  <PageHero title="Privacy Policy" imageAlt="Calming treatment room interior at AUREA spa" />

  <section class="bg-cream" style="padding: 60px 24px 120px;">
    <div style="max-width: 760px; margin: 0 auto;">
      <article style="display: flex; flex-direction: column; gap: 32px;">
        <p class="text-muted" style="font-size: 0.88rem;">Last updated: 1 March 2026</p>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">1. Who We Are</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            AUREA (&ldquo;we&rdquo;, &ldquo;our&rdquo;, &ldquo;us&rdquo;) operates a luxury spa and salon located at {SITE.address.full}. We are committed to protecting your privacy and handling your data in accordance with the UK General Data Protection Regulation (UK GDPR) and the Data Protection Act 2018.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">2. Data We Collect</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0 0 12px;">We may collect the following personal data:</p>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Name, email address, phone number, and postal address</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Booking details and treatment history</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Health information relevant to treatments (e.g. allergies, skin conditions)</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Payment information (processed securely by our payment provider)</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Website usage data via cookies and analytics</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">3. How We Use Your Data</h2>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">To manage your bookings and provide our services</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">To send appointment confirmations and reminders</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">To process payments</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">To send marketing communications (only with your consent)</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">To improve our website and services</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">4. Legal Basis</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            We process your data on the basis of: contractual necessity (to fulfil bookings), legitimate interest (to improve our services), and consent (for marketing communications). You may withdraw consent at any time.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">5. Data Sharing</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            We do not sell your personal data. We may share data with trusted service providers (payment processors, booking systems, email platforms) who process data on our behalf under strict data protection agreements.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">6. Data Retention</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            We retain your personal data for as long as necessary to provide our services and comply with legal obligations. Booking data is retained for 3 years. Marketing consent records are retained until you withdraw consent.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">7. Your Rights</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0 0 12px;">Under UK GDPR, you have the right to:</p>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Access the personal data we hold about you</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Request correction of inaccurate data</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Request deletion of your data</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Object to processing of your data</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Request data portability</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Lodge a complaint with the ICO (ico.org.uk)</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">8. Cookies</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            Our website uses essential cookies to ensure proper functionality. We do not use tracking or advertising cookies. Analytics cookies are only used with your consent.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">9. Contact Us</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            For any privacy-related enquiries, please contact us at <a href={`mailto:${SITE.email}`} class="text-sage hover:text-dark-sage transition-colors" style="text-decoration: underline;">{SITE.email}</a> or write to us at {SITE.address.full}.
          </p>
        </div>
      </article>
    </div>
  </section>
</Layout>
