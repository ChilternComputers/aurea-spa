---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has been moved."
  noindex={true}
>
  <PageHero
    title="Page Not Found"
    subtitle="404"
    description="The page you're looking for doesn't exist or has been moved."
    image="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1920&q=85&fit=crop&auto=format&fm=webp"
    imageAlt="AUREA spa interior"
  />

  <section style="background: var(--color-cream); padding: clamp(48px, 6vw, 80px) 0;">
    <div style="max-width: 600px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px); text-align: center;">

      <h2 class="font-heading" style="font-size: 1.5rem; font-weight: 300; font-style: italic; margin: 0 0 28px; color: var(--color-charcoal);">
        Let us help you find your way
      </h2>

      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
        <li>
          <a href="/treatments/" class="not-found-link" style="color: var(--color-charcoal); font-size: 1rem; text-decoration: none; transition: color 0.3s ease;">
            <span style="color: var(--color-gold); margin-right: 10px;">&#8594;</span>Treatments
          </a>
        </li>
        <li>
          <a href="/booking/" class="not-found-link" style="color: var(--color-charcoal); font-size: 1rem; text-decoration: none; transition: color 0.3s ease;">
            <span style="color: var(--color-gold); margin-right: 10px;">&#8594;</span>Booking
          </a>
        </li>
        <li>
          <a href="/contact/" class="not-found-link" style="color: var(--color-charcoal); font-size: 1rem; text-decoration: none; transition: color 0.3s ease;">
            <span style="color: var(--color-gold); margin-right: 10px;">&#8594;</span>Contact
          </a>
        </li>
        <li>
          <a href="/" class="not-found-link" style="color: var(--color-charcoal); font-size: 1rem; text-decoration: none; transition: color 0.3s ease;">
            <span style="color: var(--color-gold); margin-right: 10px;">&#8594;</span>Home
          </a>
        </li>
      </ul>

    </div>
  </section>
</Layout>

<style>
  .not-found-link:hover,
  .not-found-link:focus-visible {
    color: var(--color-sage) !important;
  }
</style>
