---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import BookingCTA from '@/components/sections/BookingCTA.astro';
import ArticleCard from '@/components/ui/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getWebPageSchema, getBreadcrumbSchema } from '@/lib/schemas';
import { SITE } from '@/config';

const allPosts = await getCollection('journal');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = ['skincare', 'wellness', 'hair', 'lifestyle', 'guides'] as const;
const categoryLabels: Record<string, string> = {
  skincare: 'Skincare',
  wellness: 'Wellness',
  hair: 'Hair',
  lifestyle: 'Lifestyle',
  guides: 'Guides',
};

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Journal', url: `${SITE.url}/journal/` },
]);
---

<Layout
  title="The Journal — Wellness & Beauty Insights"
  description="Expert advice, seasonal skincare guides and wellness insights from the AUREA team in Marylebone."
  schema={[
    getWebPageSchema({
      title: 'The Journal — AUREA',
      description: 'Expert advice, seasonal skincare guides and wellness insights from the AUREA team in Marylebone.',
      url: `${SITE.url}/journal/`,
    }),
    breadcrumbs,
  ]}
>
  <PageHero
    title="The Journal"
    subtitle="Wellness & Beauty"
    description="Expert advice, seasonal guides and behind-the-scenes insights from the AUREA team."
    image="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1920&q=85&fit=crop&auto=format&fm=webp"
    imageAlt="Serene spa setting with natural light and candles"
  />

  <section style="padding: clamp(60px, 8vw, 100px) 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <!-- Category tabs -->
      <div
        id="journal-tabs"
        role="tablist"
        aria-label="Article categories"
        style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: clamp(40px, 5vw, 64px);"
        data-reveal
      >
        <button role="tab" aria-selected="true" aria-controls="journal-grid" data-tab="all" class="tab-btn btn-primary btn-fill" style="padding: 8px 24px;" tabindex="0">
          All
        </button>
        {categories.map((cat) => (
          <button role="tab" aria-selected="false" aria-controls="journal-grid" data-tab={cat} class="tab-btn btn-primary btn-outline" style="padding: 8px 24px;" tabindex="-1">
            {categoryLabels[cat]}
          </button>
        ))}
      </div>

      <!-- Article grid -->
      <div
        id="journal-grid"
        role="tabpanel"
        aria-label="Articles"
        style="display: grid; grid-template-columns: 1fr; gap: 32px;"
        class="md:grid-cols-2 lg:grid-cols-3"
      >
        {posts.map((post) => (
          <div data-category={post.data.category} class="journal-item">
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              author={post.data.author}
              date={post.data.date}
              category={post.data.category}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
              readTime={post.data.readTime}
              slug={post.id.replace(/\.md$/, '')}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>

<script>
  import { initTabs } from '@/lib/tabs';
  initTabs('.tab-btn', '.journal-item', 'data-tab', 'data-category');
</script>
