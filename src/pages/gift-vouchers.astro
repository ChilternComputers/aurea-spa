---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import VoucherCard from '@/components/ui/VoucherCard.astro';
import { vouchers } from '@/data/gift-vouchers';
import { getWebPageSchema, getBreadcrumbSchema, getProductSchema } from '@/lib/schemas';
import { SITE } from '@/config';

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Gift Vouchers', url: `${SITE.url}/gift-vouchers/` },
]);
---

<Layout
  title="Luxury Spa Gift Vouchers from £45"
  description="Give the gift of AUREA luxury spa in Marylebone. Four beautifully presented voucher tiers — from signature treatments to full-day experiences, from £50."
  schema={[
    getWebPageSchema({
      title: 'Gift Vouchers — AUREA',
      description: 'Give the gift of AUREA luxury spa and salon in Marylebone. Choose from four beautifully presented voucher tiers — from signature treatments to full-day wellness experiences, starting at £50.',
      url: `${SITE.url}/gift-vouchers/`,
    }),
    breadcrumbs,
    ...getProductSchema(vouchers),
  ]}
>
  <PageHero
    title="Gift Vouchers"
    subtitle="The Gift of AUREA"
    description="A thoughtful, beautiful gift for someone who deserves a moment of restoration."
    image="https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=1920&q=85&fit=crop&auto=format&fm=webp"
    imageAlt="Radiant complexion after AUREA facial treatment"
  />

  <section style="padding: clamp(60px, 8vw, 100px) 0;">
    <div style="max-width: 1100px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <h2 class="sr-only">Available Vouchers</h2>
      <div
        style="display: grid; grid-template-columns: 1fr; gap: 24px;"
        class="md:grid-cols-2 lg:grid-cols-4"
        data-stagger-parent
      >
        {vouchers.map((v) => (
          <VoucherCard
            name={v.name}
            price={v.price}
            description={v.description}
            includes={v.includes}
            popular={v.popular}
          />
        ))}
      </div>

      <div style="text-align: center; margin-top: 64px; max-width: 600px; margin-left: auto; margin-right: auto;" data-reveal>
        <p class="text-muted" style="font-size: 0.9rem; line-height: 1.8; margin: 0 0 8px;">
          All vouchers are presented in our signature AUREA gift packaging and can be posted or collected in person. <a href="/booking/" style="color: var(--color-sage); text-decoration: underline; text-underline-offset: 3px;">Book online</a> or call us on <a href="tel:02079460321" style="color: var(--color-sage); text-decoration: underline; text-underline-offset: 3px;">020 7946 0321</a> to purchase.
        </p>
        <p class="text-muted" style="font-size: 0.85rem;">
          Custom amounts are also available upon request.
        </p>
      </div>
    </div>
  </section>
</Layout>
