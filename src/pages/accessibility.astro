---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { SITE } from '@/config';
import { getWebPageSchema } from '@/lib/schemas';
---

<Layout
  title="Accessibility Statement"
  description="AUREA's accessibility statement. Our commitment to WCAG 2.1 AA compliance and inclusive digital experiences."
  noindex={true}
  schema={getWebPageSchema({
    title: 'Accessibility Statement — AUREA',
    description: 'Our commitment to digital accessibility.',
    url: 'https://aurea-spa.pages.dev/accessibility/',
  })}
>
  <PageHero title="Accessibility" />

  <section class="bg-cream" style="padding: 60px 24px 120px;">
    <div style="max-width: 760px; margin: 0 auto;">
      <article style="display: flex; flex-direction: column; gap: 32px;">
        <p class="text-muted" style="font-size: 0.88rem;">Last updated: 1 March 2026</p>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Our Commitment</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            AUREA is committed to ensuring digital accessibility for all visitors, including people with disabilities. We continually improve the user experience for everyone and apply the relevant accessibility standards to achieve this.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Conformance Status</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            This website aims to conform to the Web Content Accessibility Guidelines (WCAG) 2.1 at Level AA. These guidelines explain how to make web content more accessible to people with a wide range of disabilities.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Measures Taken</h2>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Semantic HTML throughout the site for proper document structure</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Sufficient colour contrast ratios meeting WCAG AA (minimum 4.5:1 for text)</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Keyboard navigation support across all pages and interactive elements</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Skip-to-content link for efficient keyboard navigation</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">ARIA labels and roles where appropriate for screen reader compatibility</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Descriptive alt text for meaningful images</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Responsive design that works across all screen sizes and devices</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Reduced motion support for users who prefer minimal animation</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Assistive Technology Tested</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0 0 12px;">This website has been tested with the following assistive technologies:</p>
          <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">NVDA screen reader with Firefox</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">VoiceOver with Safari on macOS and iOS</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Keyboard-only navigation</li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Google Lighthouse accessibility audit</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Physical Accessibility</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            Our premises at {SITE.address.full} offers step-free access to all treatment areas on the ground floor. If you have any specific accessibility requirements, please contact us in advance so we can accommodate your needs.
          </p>
        </div>

        <div>
          <h2 class="font-heading text-charcoal" style="font-size: 1.4rem; font-weight: 400; margin: 0 0 12px;">Feedback</h2>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 0;">
            We welcome your feedback on the accessibility of this website. If you encounter any barriers or have suggestions for improvement, please contact us:
          </p>
          <ul style="margin: 12px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Email: <a href={`mailto:${SITE.email}`} class="text-sage hover:text-dark-sage transition-colors" style="text-decoration: underline;">{SITE.email}</a></li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Phone: <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="text-sage hover:text-dark-sage transition-colors" style="text-decoration: underline;">{SITE.phone}</a></li>
            <li class="text-charcoal" style="font-size: 0.95rem; line-height: 1.7;">Address: {SITE.address.full}</li>
          </ul>
          <p class="text-charcoal" style="font-size: 0.95rem; line-height: 1.8; margin: 16px 0 0;">
            We aim to respond to accessibility feedback within 5 working days.
          </p>
        </div>
      </article>
    </div>
  </section>
</Layout>
