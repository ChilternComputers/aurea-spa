---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Input from '@/components/ui/Input.astro';
import { SITE } from '@/config';
import { treatments } from '@/data/treatments';
import { team } from '@/data/team';
import { getWebPageSchema, getBreadcrumbSchema } from '@/lib/schemas';

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Booking', url: `${SITE.url}/booking/` },
]);

const treatmentNames = treatments.map((t) => t.name);
const teamNames = team.map((m) => m.name);
---

<Layout
  title="Book an Appointment — Spa, Marylebone"
  description="Book your appointment at AUREA luxury spa in Marylebone. Choose from 24 treatments, select your stylist and reserve your time slot online."
  schema={[
    getWebPageSchema({
      title: 'Book an Appointment — AUREA',
      description: 'Book your appointment at AUREA luxury spa and salon in Marylebone, London. Choose from 24 treatments, select your preferred stylist, and reserve your time slot online.',
      url: `${SITE.url}/booking/`,
    }),
    breadcrumbs,
  ]}
>
  <PageHero
    title="Book Your Visit"
    subtitle="Appointments"
    description="Reserve your treatment online. We'll confirm your booking within 2 hours."
    image="/images/unsplash/1600334129128-685c5582fd35.webp"
    imageAlt="AUREA relaxation lounge with botanical accents and natural light"
  />

  <section style="padding: clamp(48px, 6vw, 80px) 0;">
    <div style="max-width: 540px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 40px);">

      <!-- Section heading -->
      <div style="text-align: center; margin-bottom: 32px;" data-reveal>
        <h2 class="font-heading" style="font-size: 1.5rem; font-weight: 300; font-style: italic; margin: 0 0 8px; color: var(--color-charcoal);">
          Request an Appointment
        </h2>
        <div class="line-accent" style="margin: 0 auto;"></div>
      </div>

      <!-- Form -->
      <form
        id="booking-form"
        style="display: flex; flex-direction: column; gap: 16px;"
        data-reveal
      >
        <!-- Name row -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <Input label="First Name" name="firstName" required placeholder="First name" autocomplete="given-name" />
          <Input label="Last Name" name="lastName" required placeholder="Last name" autocomplete="family-name" />
        </div>

        <!-- Contact row -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <Input label="Email" name="email" type="email" required placeholder="your@email.com" autocomplete="email" />
          <Input label="Phone" name="phone" type="tel" required placeholder="07xxx xxx xxx" autocomplete="tel" />
        </div>

        <!-- Treatment — full width (names are long) -->
        <Input
          label="Treatment"
          name="treatment"
          type="select"
          required
          options={treatmentNames}
        />

        <!-- Stylist — full width -->
        <Input
          label="Preferred Stylist / Therapist"
          name="stylist"
          type="select"
          options={['No preference', ...teamNames]}
          placeholder="No preference"
        />

        <!-- Date & time row -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <Input label="Preferred Date" name="date" type="date" required />
          <Input
            label="Preferred Time"
            name="time"
            type="select"
            required
            options={['09:00', '09:30', '10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '17:00', '17:30', '18:00', '18:30', '19:00']}
            placeholder="Select a time"
          />
        </div>

        <!-- Notes -->
        <Input
          label="Additional Notes"
          name="notes"
          type="textarea"
          placeholder="First visit, allergies, special requests..."
        />

        <!-- Submit -->
        <button
          type="submit"
          class="font-body"
          style="width: 100%; padding: 14px 40px; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; border: none; cursor: pointer; background: var(--color-sage); color: var(--color-cream); transition: background 0.3s ease; line-height: 1; margin-top: 4px;"
        >
          Request Booking
        </button>

        <!-- Form message -->
        <div id="form-message" role="status" aria-live="polite" style="display: none; text-align: center; padding: 14px; font-size: 0.85rem; line-height: 1.7;"></div>
      </form>

      <!-- Divider -->
      <div style="height: 1px; background: rgba(197, 165, 114, 0.15); margin: 36px 0;"></div>

      <!-- Visit info — centred below form -->
      <div style="text-align: center;" data-reveal>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; font-size: 0.82rem; color: var(--color-charcoal); line-height: 1.7;">
          <span>{SITE.address.street}, {SITE.address.area}, {SITE.address.city} {SITE.address.postcode}</span>
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 16px; font-size: 0.8rem; color: var(--color-muted); margin-top: 8px; line-height: 1.7;">
          <span>{SITE.hours.weekday.label}: {SITE.hours.weekday.open} – {SITE.hours.weekday.close}</span>
          <span style="color: rgba(197, 165, 114, 0.4);">|</span>
          <span>{SITE.hours.saturday.label}: {SITE.hours.saturday.open} – {SITE.hours.saturday.close}</span>
          <span style="color: rgba(197, 165, 114, 0.4);">|</span>
          <span>{SITE.hours.sunday.label}: {SITE.hours.sunday.open} – {SITE.hours.sunday.close}</span>
        </div>
        <div style="display: flex; justify-content: center; gap: 20px; margin-top: 8px; font-size: 0.82rem;">
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="color: var(--color-sage); transition: opacity 0.3s ease;">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} style="color: var(--color-sage); transition: opacity 0.3s ease;">{SITE.email}</a>
        </div>
        <p style="font-size: 0.72rem; color: var(--color-muted); margin: 16px 0 0; line-height: 1.6;">
          24 hours' notice required for cancellations. Late cancellations may incur a 50% charge.
        </p>
      </div>

    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const message = document.getElementById('form-message');

  // Set date min to today (client-side, not stale build date)
  const dateField = form?.querySelector('[name="date"]') as HTMLInputElement;
  if (dateField) {
    dateField.min = new Date().toISOString().split('T')[0];
  }

  function clearFieldError(input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) {
    input.style.borderColor = '';
    input.removeAttribute('aria-invalid');
    const errorEl = document.getElementById(`${input.id}-error`);
    if (errorEl) { errorEl.style.display = 'none'; errorEl.textContent = ''; }
  }

  function setFieldError(input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, msg: string) {
    input.style.borderColor = 'var(--color-gold)';
    input.setAttribute('aria-invalid', 'true');
    const errorEl = document.getElementById(`${input.id}-error`);
    if (errorEl) { errorEl.style.display = 'block'; errorEl.textContent = msg; }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Clear all previous errors
    form.querySelectorAll('.field-error').forEach((el) => {
      (el as HTMLElement).style.display = 'none';
      el.textContent = '';
    });

    const required = form.querySelectorAll('[required]');
    let valid = true;
    const invalidFields: string[] = [];

    required.forEach((field) => {
      const input = field as HTMLInputElement | HTMLSelectElement;
      if (!input.value.trim()) {
        valid = false;
        const label = form.querySelector(`label[for="${input.id}"]`);
        const fieldName = label?.textContent?.replace(' *', '').trim() || input.name;
        invalidFields.push(fieldName);
        setFieldError(input, `${fieldName} is required.`);
      } else {
        clearFieldError(input);
      }
    });

    const emailField = form.querySelector('[name="email"]') as HTMLInputElement;
    if (emailField && emailField.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailField.value)) {
      valid = false;
      invalidFields.push('Email (invalid format)');
      setFieldError(emailField, 'Please enter a valid email address.');
    }

    if (!valid) {
      if (message) {
        message.style.display = 'block';
        message.style.color = 'var(--color-gold)';
        message.style.background = 'rgba(197, 165, 114, 0.08)';
        message.setAttribute('role', 'alert');
        message.textContent = invalidFields.length
          ? `Please complete: ${invalidFields.join(', ')}.`
          : 'Please complete all required fields.';
      }
      const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement;
      firstInvalid?.focus();
      return;
    }

    if (message) {
      message.style.display = 'block';
      message.style.color = 'var(--color-sage)';
      message.style.background = 'rgba(74, 93, 78, 0.08)';
      message.style.border = '1px solid rgba(74, 93, 78, 0.15)';
      message.innerHTML = '<strong>Thank you!</strong> Your booking request has been received. We\'ll confirm within 2 hours.';
    }

    form.reset();
  });
</script>
