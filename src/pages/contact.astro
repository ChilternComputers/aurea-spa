---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { SITE } from '@/config';
import { getWebPageSchema, getBreadcrumbSchema, getBusinessSchema } from '@/lib/schemas';

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Contact', url: `${SITE.url}/contact/` },
]);
---

<Layout
  title="Contact — Spa & Salon, Marylebone"
  description="Get in touch with AUREA luxury spa in Marylebone. Find our address, opening hours, phone number, email and nearest tube stations."
  schema={[
    getWebPageSchema({
      title: 'Contact — AUREA',
      description: 'Get in touch with AUREA luxury spa and salon in Marylebone, London. Find our address, opening hours, phone number, email, and nearest tube stations for easy directions.',
      url: `${SITE.url}/contact/`,
    }),
    breadcrumbs,
    getBusinessSchema(),
  ]}
>
  <PageHero
    title="Get in Touch"
    subtitle="Contact"
    description="We'd love to hear from you. Visit us, call, or drop us a message."
    image="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1920&q=85&fit=crop&auto=format&fm=webp"
    imageAlt="Calming nature-inspired interior at AUREA spa, Marylebone London"
  />

  <section style="padding: clamp(60px, 8vw, 100px) 0;">
    <div style="max-width: 640px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); text-align: center;">

      <!-- Contact blocks -->
      <div style="display: flex; flex-direction: column; gap: 40px;" data-reveal>

        <!-- Address -->
        <div>
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 12px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="font-body" style="font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; color: var(--color-sage);">
              Location
            </span>
          </div>
          <p style="font-size: 1.02rem; line-height: 1.8; margin: 0; color: var(--color-charcoal);">
            {SITE.address.street}<br />
            {SITE.address.area}<br />
            {SITE.address.city} {SITE.address.postcode}
          </p>
          <p style="font-size: 0.85rem; margin: 10px 0 0; color: var(--color-muted);">
            Nearest tube: Bond Street (5 min walk) or Baker Street (7 min walk)
          </p>
        </div>

        <!-- Divider -->
        <div style="height: 1px; max-width: 80px; margin: 0 auto; background: rgba(197, 165, 114, 0.25);"></div>

        <!-- Phone & Email -->
        <div>
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 12px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span class="font-body" style="font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; color: var(--color-sage);">
              Telephone & Email
            </span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} style="font-size: 1.15rem; font-weight: 500; color: var(--color-charcoal); transition: color 0.3s ease;" class="hover:text-sage">
              {SITE.phone}
            </a>
            <a href={`mailto:${SITE.email}`} style="font-size: 1rem; color: var(--color-charcoal); transition: color 0.3s ease;" class="hover:text-sage">
              {SITE.email}
            </a>
          </div>
        </div>

        <!-- Divider -->
        <div style="height: 1px; max-width: 80px; margin: 0 auto; background: rgba(197, 165, 114, 0.25);"></div>

        <!-- Hours -->
        <div>
          <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 12px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-sage)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="font-body" style="font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; color: var(--color-sage);">
              Opening Hours
            </span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 5px; max-width: 300px; margin: 0 auto;">
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 0.95rem; color: var(--color-charcoal);">{SITE.hours.weekday.label}</span>
              <span style="font-size: 0.95rem; color: var(--color-muted);">{SITE.hours.weekday.open} – {SITE.hours.weekday.close}</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 0.95rem; color: var(--color-charcoal);">{SITE.hours.saturday.label}</span>
              <span style="font-size: 0.95rem; color: var(--color-muted);">{SITE.hours.saturday.open} – {SITE.hours.saturday.close}</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="font-size: 0.95rem; color: var(--color-charcoal);">{SITE.hours.sunday.label}</span>
              <span style="font-size: 0.95rem; color: var(--color-muted);">{SITE.hours.sunday.open} – {SITE.hours.sunday.close}</span>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div style="height: 1px; max-width: 80px; margin: 0 auto; background: rgba(197, 165, 114, 0.25);"></div>

        <!-- Social -->
        <div>
          <span class="font-body" style="font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; color: var(--color-sage); display: block; margin-bottom: 14px;">
            Follow Us
          </span>
          <div style="display: flex; justify-content: center; gap: 20px;">
            <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="color: var(--color-charcoal); transition: color 0.3s ease;" class="hover:text-sage">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color: var(--color-charcoal); transition: color 0.3s ease;" class="hover:text-sage">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="color: var(--color-charcoal); transition: color 0.3s ease;" class="hover:text-sage">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
