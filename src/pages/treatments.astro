---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import BookingCTA from '@/components/sections/BookingCTA.astro';
import TreatmentCard from '@/components/ui/TreatmentCard.astro';
import { treatments, categoryLabels, type TreatmentCategory } from '@/data/treatments';
import { getWebPageSchema, getBreadcrumbSchema, getServiceSchema } from '@/lib/schemas';
import { SITE } from '@/config';

const categories = Object.keys(categoryLabels) as TreatmentCategory[];

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: SITE.url },
  { name: 'Treatments', url: `${SITE.url}/treatments/` },
]);
---

<Layout
  title="Luxury Hair, Beauty & Wellness Treatments"
  description="Explore our full menu of luxury hair, facial, massage, nail and wellness treatments at AUREA Marylebone. Expert care tailored to you."
  schema={[
    getWebPageSchema({
      title: 'Treatments — AUREA',
      description: 'Explore our full menu of luxury hair, facial, massage, nail, and wellness treatments at AUREA Marylebone. Expert care tailored to you in an intimate, nature-inspired setting.',
      url: `${SITE.url}/treatments/`,
    }),
    breadcrumbs,
    ...getServiceSchema(treatments),
  ]}
>
  <PageHero
    title="Our Treatments"
    subtitle="Services"
    description="Every treatment is tailored to you. From transformative colour to restorative massage, discover the full AUREA menu."
    image="/images/unsplash/1544161515-4ab6ce6db874.webp"
    imageAlt="Relaxing hot stone massage at AUREA spa, Marylebone"
  />

  <section style="padding: clamp(60px, 8vw, 100px) 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px);">
      <!-- Category tabs -->
      <div
        id="treatment-tabs"
        role="tablist"
        aria-label="Treatment categories"
        style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: clamp(40px, 5vw, 64px);"
        data-reveal
      >
        <button role="tab" aria-selected="true" aria-controls="treatment-grid" data-tab="all" class="tab-btn btn-primary btn-fill" style="padding: 8px 24px;" tabindex="0">
          All
        </button>
        {categories.map((cat) => (
          <button role="tab" aria-selected="false" aria-controls="treatment-grid" data-tab={cat} class="tab-btn btn-primary btn-outline" style="padding: 8px 24px;" tabindex="-1">
            {categoryLabels[cat]}
          </button>
        ))}
      </div>

      <!-- Treatment grid -->
      <div
        id="treatment-grid"
        role="tabpanel"
        aria-label="Treatments"
        style="display: grid; grid-template-columns: 1fr; gap: 16px;"
        class="md:grid-cols-2 lg:grid-cols-3"
      >
        {treatments.map((t) => (
          <div data-category={t.category} class="treatment-item">
            <TreatmentCard
              name={t.name}
              description={t.description}
              duration={t.duration}
              price={t.price}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>

<script>
  import { initTabs } from '@/lib/tabs';
  initTabs('.tab-btn', '.treatment-item', 'data-tab', 'data-category');
</script>
